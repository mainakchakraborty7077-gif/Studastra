# --- Public (safe for the browser; protected by RLS) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Optional: canonical site URL (used for social preview images)
NEXT_PUBLIC_SITE_URL=https://your-domain.example
# Optional: shown on /support
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=

# --- Server only (NEVER prefix with NEXT_PUBLIC_) ---
# Supabase → Project Settings → API → service_role / secret key.
# Used only by /api/admin/* and /api/auth/* route handlers to create accounts,
# look up mobile numbers before sending an OTP, and write the audit log.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
